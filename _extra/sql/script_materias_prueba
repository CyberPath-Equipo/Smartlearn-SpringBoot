-- 4. Teoría del subtema (id_subtema = 1)
INSERT INTO tbl_teoria (id_subtema, contenido, revisado) VALUES
(1,
'La fotosíntesis es un proceso fundamental realizado por las plantas, algas y algunas bacterias. \n\n'
'En este proceso, la luz solar es capturada por la clorofila, un pigmento verde ubicado en los cloroplastos. \n'
'Mediante una serie de reacciones, las plantas convierten el dióxido de carbono (CO₂) del aire y el agua (H₂O) del suelo en glucosa (C₆H₁₂O₆) y oxígeno (O₂). \n\n'
'La ecuación general de la fotosíntesis es:\n'
'6CO₂ + 6H₂O + luz solar → C₆H₁₂O₆ + 6O₂\n\n'
'Este proceso ocurre en dos etapas principales: la fase luminosa (dependiente de la luz) y la fase oscura o ciclo de Calvin (independiente de la luz). \n'
'La glucosa producida sirve como fuente de energía y materia prima para el crecimiento de la planta, mientras que el oxígeno liberado es esencial para la respiración de los seres vivos.',
1);

